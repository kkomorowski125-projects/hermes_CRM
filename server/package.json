{
  "name": "hermes-crm-server",
  "version": "0.16.2",
  "private": true,
  "type": "module",
  "description": "Serwer Hermes CRM: API, konta, zespoły, synchronizacja danych i proxy AI.",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test --test-concurrency=1 test/*.test.ts",
    "migrate": "tsx src/migrate.ts"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "fastify": "^5.6.0",
    "nodemailer": "^7.0.13",
    "pg": "^8.16.0"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.15.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.15.0",
    "jsdom": "^26.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
