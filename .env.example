# Skopiuj do .env i uzupełnij. Wartości puste lub pominięte mają bezpieczne ustawienia domyślne.

# Adres, pod którym działa aplikacja (w linkach zaproszeń i resetu hasła)
PUBLIC_URL=http://localhost:3000
# Hasło bazy PostgreSQL w docker compose
POSTGRES_PASSWORD=zmien_mnie
# Ciasteczka tylko przez HTTPS: ustaw true na produkcji za certyfikatem
SECURE_COOKIES=false
# open: każdy może założyć firmę; closed: tylko przez zaproszenie
SIGNUP=open
# Długość sesji w dniach
SESSION_DAYS=30

# Hermes AI przez serwer (puste = tryb lokalny bez Claude)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
AI_DAILY_LIMIT=200

LOG_LEVEL=info

# Maile (zaproszenia, reset hasła, poranny plan): dowolny dostawca SMTP
SMTP_URL=
MAIL_FROM=Hermes CRM <crm@twojafirma.pl>

# Logowanie Google i Microsoft (puste = przyciski ukryte)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common

# Poranny plan dnia mailem: godzina w czasie polskim (puste = wyłączony)
DIGEST_HOUR=7

# Alerty o błędach serwera: webhook Slacka, Teams albo Discorda
ALERT_WEBHOOK_URL=

# Szyfrowane kopie bazy do ./backups (puste hasło = kopie wyłączone)
BACKUP_PASSPHRASE=
BACKUP_HOUR=1
BACKUP_KEEP_DAYS=14

# HTTPS przez Caddy: docker compose --profile https up -d --build
DOMAIN=
# Przy profilu https wystaw aplikację tylko lokalnie: APP_PORT=127.0.0.1:3000
APP_PORT=3000
