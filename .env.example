# Skopiuj do .env i uzupełnij. Wartości puste lub pominięte mają bezpieczne ustawienia domyślne.

# Adres, pod którym działa aplikacja (w linkach zaproszeń i resetu hasła)
PUBLIC_URL=http://localhost:3000
# Hasło bazy PostgreSQL w docker compose
POSTGRES_PASSWORD=zmien_mnie
# Ciasteczka tylko przez HTTPS: ustaw true na produkcji za certyfikatem
SECURE_COOKIES=false
# open: każdy może założyć firmę; closed: tylko przez zaproszenie
SIGNUP=open
# Długość sesji w dniach
SESSION_DAYS=30

# Hermes AI przez serwer (puste = tryb lokalny bez Claude)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
AI_DAILY_LIMIT=200

LOG_LEVEL=info
